# ==============================================================================
# MEDUSA V2 BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Architecture: Single Source of Truth via Central ID (Supabase)
# ==============================================================================

# Server Port
PORT=9000

# ------------------------------------------------------------------------------
# Database Connection (PostgreSQL SSOT - Schema Isolation: medusa)
# ------------------------------------------------------------------------------
# Development: postgres://postgres:postgres@127.0.0.1:55322/postgres?options=-c%20search_path%3Dmedusa,public
# Production:  postgres://postgres:<DB_PASSWORD>@<DB_HOST>:5432/postgres?options=-c%20search_path%3Dmedusa,public
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55322/postgres?options=-c%20search_path%3Dmedusa,public

# ------------------------------------------------------------------------------
# Central ID SSOT (Asymmetric ES256 JWKS Token Verification)
# ------------------------------------------------------------------------------
# Development: http://127.0.0.1:55321/auth/v1/.well-known/jwks.json
# Production:  https://id.tuquet.com/auth/v1/.well-known/jwks.json
ID_JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# Security Secrets (Must be at least 32 characters in production)
# ------------------------------------------------------------------------------
JWT_SECRET=supersecret-replace-with-at-least-32-characters-in-prod
COOKIE_SECRET=supersecret-replace-with-at-least-32-characters-in-prod

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
# Development: http://localhost:8000,http://localhost:5173,http://localhost:9000
# Production:  https://store.tuquet.com,https://console.tuquet.com,https://tuquet.com
STORE_CORS=http://localhost:8000,https://store.tuquet.com
ADMIN_CORS=http://localhost:5173,http://localhost:5666,https://console.tuquet.com
AUTH_CORS=http://localhost:8000,http://localhost:5173,http://localhost:5666,https://store.tuquet.com,https://console.tuquet.com
