# ==============================================================================
# NEXT.JS STOREFRONT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Architecture: Root Domain Cookie SSO (.tuquet.com) & Medusa v2 SDK
# ==============================================================================

# Application URL
# Development: http://localhost:8000
# Production:  https://store.tuquet.com
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Medusa v2 Backend API Endpoint
# Development: http://localhost:9000
# Production:  https://api.store.tuquet.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (Created from Medusa Admin Dashboard)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_api_key_here

# ------------------------------------------------------------------------------
# Central ID SSOT (Supabase Auth Client & SSR)
# ------------------------------------------------------------------------------
# Development: http://127.0.0.1:55321
# Production:  https://id.tuquet.com
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ------------------------------------------------------------------------------
# Seamless SSO Root Cookie Scope
# ------------------------------------------------------------------------------
# Development: leave empty or localhost
# Production:  .tuquet.com
NEXT_PUBLIC_COOKIE_DOMAIN=
