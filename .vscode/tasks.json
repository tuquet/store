{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "local: <fullstack> dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "local: <backend> dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "backend:dev"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "local: <storefront> dev",
